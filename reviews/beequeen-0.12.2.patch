@@ -0,0 +1,61 @@
+-- 战吼阶段：冲刺时带走守卫；冲刺解除当帧折返，不围圈等待队形。
+local Status=require("shadowself/control/status")
+local D={}
+function D.Dashing(bee)
+ if Status.Sleeping(bee) or Status.Frozen(bee) then return false end
+ local a=bee.AnimState
+ if a and a.GetBuild and a:GetBuild()=="bee_guard_puffy_build" then return true end
+ local loco=bee.components and bee.components.locomotor
+ return loco and loco.walkspeed and loco.walkspeed>(TUNING.BEEGUARD_SPEED or 3) or false
+end
+local function enter(q,state,queen,pos,roar)
+ state.mode="pull";state.seen_dash=nil;state.wait_dash=roar
+ local qp=queen:GetPosition();local dx,dz=pos.x-qp.x,pos.z-qp.z;local d=math.sqrt(dx*dx+dz*dz)
+ if d<.01 then dx,dz,d=1,0,1 end
+ state.dir={x=dx/d,z=dz/d};state.tangent=nil;q.stage="dash_pull"
+end
+function D.Tick(q,queen,bees,now)
+ local c=q.c;local p=c.player;local pos=p:GetPosition();local qp=queen:GetPosition()
+ local state=q.dash_cycle or {mode="solo"};q.dash_cycle=state
+ local a=queen.AnimState;local roar=a:IsCurrentAnimation("command1") or a:IsCurrentAnimation("command2") or a:IsCurrentAnimation("command3")
+ local frame=a.GetCurrentAnimationFrame and a:GetCurrentAnimationFrame() or 0
+ local ending=a:IsCurrentAnimation("command3") and frame>=23
+ local dashing=false;local near=math.huge;local awake=false
+ for _,bee in ipairs(bees) do
+  dashing=D.Dashing(bee) or dashing
+  if not Status.Sleeping(bee) and not Status.Frozen(bee) then awake=true;near=math.min(near,math.sqrt(pos:DistSq(bee:GetPosition()))) end
+ end
+ local new_roar=roar and not state.was_roar;local new_dash=dashing and not state.was_dash
+ state.was_roar=roar;state.was_dash=dashing
+ q:Target(queen)
+ if not awake then state.mode="solo" end
+ if awake and ((new_roar and not ending) or new_dash and not ending) then enter(q,state,queen,pos,true) end
+ if state.mode=="solo" and awake and near<6 then enter(q,state,queen,pos,false) end
+ if state.mode=="pull" then
+  if dashing then state.seen_dash=true end
+  local finished=ending or state.seen_dash and not dashing
+  if finished or not state.wait_dash and not dashing and q:Formation(queen,bees,pos) then
+   state.mode="return";q.stage="dash_return";c.next_move=nil
+  else
+   local dir=state.dir;local distance=math.sqrt(pos:DistSq(qp))
+   if distance>=16.5 or pos:DistSq(q.anchor)>36^2 then
+    state.tangent=state.tangent or {x=-dir.z,z=dir.x};dir=state.tangent
+   end
+   q.stage="dash_pull";q:Move(Vector3(pos.x+dir.x*4,0,pos.z+dir.z*4),"蜂后三阶段 · 冲刺带走守卫",queen)
+   return true
+  end
+ end
+ if state.mode=="return" then
+  local reach=(c.gear.AttackRange and c.gear:AttackRange() or 2)+(queen.GetPhysicsRadius and queen:GetPhysicsRadius(0) or .5)-.3
+  local distance=math.sqrt(pos:DistSq(qp))
+  if distance>reach+.2 then
+   local d=math.max(.01,distance)
+   local goal=Vector3(qp.x+(pos.x-qp.x)/d*reach,0,qp.z+(pos.z-qp.z)/d*reach)
+   q.stage="dash_return";q:Move(goal,"蜂后三阶段 · 冲刺已结束，直线折返蜂后",queen);return true
+  end
+  q:ReleaseTravel();c.bridge.chasing=nil;if c.travel then c.travel.chasing=nil end
+  state.mode="solo"
+ end
+ q.stage="strike";return q:Strike(queen,pos,qp,math.sqrt(pos:DistSq(qp)))
+end
+return D
