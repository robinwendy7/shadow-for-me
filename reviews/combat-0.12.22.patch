+function O.DragonDown(e)
+ return e and e.prefab=="dragonfly" and (anim(e,"hit_large") or anim(e,"hit_ground") or anim(e,"sleep_loop") or e:HasTag("grounded") or e.sg and e.sg.HasStateTag and e.sg:HasStateTag("grounded"))
+end
+function O.Planar(c)
