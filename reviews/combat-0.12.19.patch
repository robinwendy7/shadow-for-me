+-- 0.12.19：攻击形状、固定落点及每次攻击的侧方检查；物理与网络为模拟。
+local now=0;GetTime=function() return now end
+Vector3=function(x,y,z) local p={x=x,y=y,z=z};function p:DistSq(q) return (self.x-q.x)^2+(self.z-q.z)^2 end;return p end
