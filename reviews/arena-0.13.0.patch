diff --git a/tests/arena_lifecycle.lua b/tests/arena_lifecycle.lua
new file mode 100644
index 0000000..07c0b49
--- /dev/null
+++ b/tests/arena_lifecycle.lua
@@ -0,0 +1,55 @@
+local Data=require('shadowself/data/arena_classic');local Policy=require('shadowself/control/arena_policy')
+local expectedEncounter=assert(loadstring(read_astra_source('astra/modes/arena/encounters.lua')))().WAVES_1_2
+local expectedSupply=assert(loadstring(read_astra_source('astra/modes/arena/supplies.lua')))().WAVES_1_2
+local function equal(a,b)
+ if type(a)~='table' then assert(a==b);return end
+ assert(type(b)=='table');for k,v in pairs(a) do equal(v,b[k]) end;for k in pairs(b) do assert(a[k]~=nil) end
+end
+equal(expectedEncounter,Data.encounters);equal(expectedSupply,Data.supplies)
+assert(#Data.encounters==15 and #Policy.waves==15)
+assert(Policy.Keep('panflute',15) and Policy.Keep('armorsnurtleshell',15))
+assert(not Policy.Upgrade({prefab='cane'},{ruins_bat=true},15))
+assert(Policy.Upgrade({prefab='spear'},{ruins_bat=true},7),'only discard known obsolete equipment after a replacement exists')
+assert(not Policy.Upgrade({prefab='spear'},{},7))
+assert(not Policy.Upgrade({prefab='unknown_mod_relic'},{ruins_bat=true},15),'never discard unknown player equipment')
+local charged={prefab='lightninggoat',HasTag=function(_,tag) return tag=='charged' end}
+assert(Policy.ArmorScore({prefab='rainhat'},'head',{charged})>Policy.ArmorScore({prefab='eyebrellahat'},'head',{charged}),'stable insulation ranking')
+local saved={};for _,key in ipairs({'shadowself/control/actions','shadowself/control/arena_adapter','shadowself/control/combat'}) do saved[key]=package.loaded[key] end
+local oldTime=GetTime;local now=0;GetTime=function() return now end
+local snapshot={state={lobby_state='LOBBY'}};local starts,stops,prepares,cancels=0,0,0,0;local active=false
+local adapter={Snapshot=function() return snapshot end,Prepare=function() prepares=prepares+1;return 'running' end,Cancel=function() cancels=cancels+1 end}
+package.loaded['shadowself/control/arena_adapter']=function() return adapter end
+package.loaded['shadowself/control/combat']=function() return {Running=function() return active end,Start=function() active=true;starts=starts+1;return true end,Stop=function() active=false;stops=stops+1 end} end
+package.loaded['shadowself/control/actions']={Items=function() return {} end,Stop=function() end}
+package.loaded['shadowself/control/arena']=nil
+local p={tags={},replica={inventory={GetItems=function() return {} end}},components={playercontroller={IsBusy=function() return false end}}}
+function p:HasTag(t) return self.tags[t] or false end
+function p:GetPosition() return Vector3(0,0,0) end
+local task=require('shadowself/control/arena')(p,{loop=true})
+task.Entities=function() return {{IsValid=function() return true end,GetPosition=function() return Vector3(2,0,0) end}},{} end
+task.Loot=function() return false end;task.Equip=function() return false end
+assert(task:Tick()=='running' and prepares==1 and starts==0,'no combat before server-confirmed arena instance')
+snapshot={state={},instance='one',generation=1,kind='PARTICIPANT',arena=true,wave=1,route='default'}
+task:Tick();assert(starts==1 and task:OwnsCombat())
+snapshot.wave=2;task:Tick();assert(starts==1,'wave transition reuses combat rather than starting competing threads')
+local equips=0
+local entities=task.Entities
+task.Entities=function() return {},{} end
+task.Loot=function() return true end
+task.Equip=function() equips=equips+1;return true end
+task:Tick();assert(equips==0,'pending pickup cannot be overwritten by equip')
+task.Loot=function() return false end
+task:Tick();assert(equips==1,'equip allowed when no pending pickup')
+task.Entities=entities
+snapshot.settlement={mode_id='ARENA',visible=true};task:Tick();assert(not active and prepares==1,'settlement does not immediately requeue')
+p.tags.corpse=true;snapshot.settlement=nil;task:Tick();assert(prepares==1,'await server corpse restoration')
+p.tags.corpse=nil;snapshot={state={lobby_state='LOBBY'}};task:Tick();assert(prepares==2,'server-confirmed return permits next solo loop')
+task:Cancel();assert(cancels==1 and not task.running and not active)
+for _,key in ipairs({'shadowself/control/actions','shadowself/control/arena_adapter','shadowself/control/combat'}) do package.loaded[key]=saved[key] end
+package.loaded['shadowself/control/arena']=nil;GetTime=oldTime
+local parser=require('shadowself/control/request')
+assert(parser.Parse('帮我循环角斗场').kind=='arena')
+assert(parser.Parse('自动单人角斗场').kind=='arena')
+local no=parser.Parse('不要自动角斗场');assert(not no)
+assert(not parser.Parse('停止角斗场循环'),'stop must not request another arena run')
+print('PASS: all15 waves match actual server data; equipment reserves/obsolete rules; authoritative instance/settlement/restore/requeue/cancel lifecycle; arena commands')
diff --git a/tests/arena_protocol.lua b/tests/arena_protocol.lua
new file mode 100644
index 0000000..67b09f6
--- /dev/null
+++ b/tests/arena_protocol.lua
@@ -0,0 +1,47 @@
+local savedTime=GetTime;local now=0;GetTime=function() return now end
+local function net(v) return {value=function() return v end} end
+local state={revision=1,lobby_state="LOBBY",preparation={selection={},ready={}},userid="test"}
+local sent={};local private={}
+local env=setmetatable({ThePlayer=nil,TheWorld=nil,TheNet=nil,TheFocalPoint=nil,
+ GetModRPC=function(namespace,name) assert(namespace=="ASTRA" and name=="lobby_request");return 71 end,
+ SendModRPCToServer=function(...) sent[#sent+1]={...} end},{__index=_G})
+env.require=function(name)
+ if private[name] then return private[name] end
+ local fn=assert(loadstring(read_astra_source(name..".lua"),name));setfenv(fn,env)
+ local result=fn();private[name]=result;return result
+end
+local function loadmodule(name) return env.require(name) end
+local player={userid="test",astra_player_classified={astra_lobby_state_revision=net(1),astra_lobby_state_payload=net(state),
+ astra_lobby_catalog_revision=net(1),astra_lobby_catalog_payload=net({modes={}}),astra_lobby_roster_revision=net(1),astra_lobby_roster_payload=net({players={}})}}
+env.ThePlayer=player
+local client=loadmodule("astra/ui/lobby_client").New(player);client:Refresh(true)
+assert(client:IsAvailable(),'actual server lobby client recognizes authoritative classified channels')
+local ok,id=client:Send("QUEUE_JOIN",{mode_id="ARENA",mode_version=1,variant_id="ARENA_CLASSIC_SOLO",direct_start=true})
+assert(ok and id and #sent==1 and sent[1][1]==71 and sent[1][3]=="QUEUE_JOIN",'real ASTRA client -> real RPC encoder')
+local hasvariant,hasdirect=false,false
+for _,v in pairs(sent[1]) do if v=="ARENA_CLASSIC_SOLO" then hasvariant=true end;if v==true then hasdirect=true end end
+assert(hasvariant and hasdirect and client:IsActionPending("QUEUE_JOIN"),'single variant and direct-start travel through actual sender')
+-- Isolated adapter with asynchronous server acknowledgements.
+local oldL,oldH=package.loaded['astra/ui/lobby_client'],package.loaded['astra/ui/mode_hud_client']
+local c={pending={},requests={},Refresh=function() end,IsAvailable=function() return true end,GetState=function() return state end,
+ GetLastResponse=function() return state.last_response end,IsActionPending=function(self,a) return self.pending[a] end,
+ Send=function(self,a,f) self.requests[#self.requests+1]={a=a,f=f};self.pending[a]=true;return true,'r'..#self.requests end}
+package.loaded['astra/ui/lobby_client']={New=function() return c end}
+package.loaded['astra/ui/mode_hud_client']={New=function() return {Refresh=function() end,GetModel=function() end,GetTarget=function() end} end}
+local oldSet=package.loaded['astra/net/settlement_hud_state'];package.loaded['astra/net/settlement_hud_state']={}
+local Adapter=require('shadowself/control/arena_adapter');local adapter=Adapter(player)
+adapter:Prepare({state=state});assert(c.requests[1].a=='LOBBY_CONFIGURE')
+now=2;adapter:Prepare({state=state});assert(#c.requests==1,'pending configure cannot cause repeated starts')
+c.pending={};state.preparation.selection={mode_id='ARENA',variant_id='ARENA_CLASSIC_SOLO'}
+adapter:Prepare({state=state});assert(c.requests[2].a=='LOBBY_READY' and c.requests[2].f.ready==true)
+now=4;c.pending={};state.preparation.ready.test=true;state.preparation.all_ready=false
+adapter:Prepare({state=state});assert(#c.requests==2,'readiness alone is insufficient before server all_ready')
+state.preparation.all_ready=true;state.party={party_id='p',revision=7,leader_userid='test',members={{userid='test'}},state='OPEN'}
+adapter:Prepare({state=state});assert(c.requests[3].a=='QUEUE_JOIN' and c.requests[3].f.party_revision==7 and c.requests[3].f.direct_start)
+state.party.members[2]={userid='other'};now=6
+local status=adapter:Prepare({state=state});assert(status=='failed' and #c.requests==3,'do not split or take over a multiplayer party')
+state.party.members[2]=nil;state.ticket={};state.party.state='QUEUED';adapter:Cancel()
+assert(c.requests[4].a=='QUEUE_CANCEL','cancel only own queued ticket')
+package.loaded['astra/ui/lobby_client'],package.loaded['astra/ui/mode_hud_client'],package.loaded['astra/net/settlement_hud_state']=oldL,oldH,oldSet
+GetTime=savedTime
+print('PASS: actual ASTRA client/RPC encoder, solo variant/direct start, version fields, pending acknowledgement, server readiness and party/cancel boundaries')
