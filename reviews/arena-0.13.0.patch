+ [10]={name="龙蝇",keep={"armorskeleton","armorruins","nightmarefuel","nightsword"},note="龙蝇全走位，倒地持续输出；骨甲留后续，不用它换血。"},
+ [11]={name="路线分流",keep={"voltgoatjelly_spice_chili","firestaff","icestaff"},note="按疯猪/拾荒疯猪/洞穴巨虫实际组合，群怪选最近敌人。"},
