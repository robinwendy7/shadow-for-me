+ local gear=c.gear;local pending=gear.pending;local hand=gear.support_hand
+ M.Event(c,"snapshot",{phase=q.phase,stage=q.stage,mode=fields.mode,queen=M.Entity(queen),queen_anim=animation(queen),queen_frame=queen.AnimState:GetCurrentAnimationFrame(),queen_in_scan=seen,
+  pos=M.Point(pos),queen_pos=M.Point(qp),distance=math.sqrt(pos:DistSq(qp)),guards=#guards,boosted=boost,sleeping=sleep,frozen=frozen,nearest=near<math.huge and near or -1,
+  target=M.Entity(c.h.ent),busy=busy,player_anim=animation(p),health=percent or -1,blocked=c.blocked==true,native=c.bridge.OwnsThread and c.bridge:OwnsThread() or false,
+  chasing=c.bridge.chasing==true,held=M.Entity(p.replica.inventory:GetEquippedItem(EQUIPSLOTS.HANDS)),forced=M.Entity(gear.forced_weapon),pending=M.Entity(pending and pending.item),support=hand and hand.phase or "none",
+  goal=M.Point(s.goal),moved=distance,stalled=stalled,select_veto=s.counts.select_veto or 0,attack_veto=s.counts.attack_veto or 0,dropped=s.dropped,reason=c.status or "none"})
+end
+function M.Sample(q)
+ if not M.enabled or not q or not q.c or not q.c._queen_debug then return end
+ local ok,error=pcall(sample,q)
+ if not ok then M.Throttle(q.c,"logger_error",30,"logger_error",{message=tostring(error)}) end
+end
+return M
