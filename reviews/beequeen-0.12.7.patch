+local M={VERSION="0.12.7",enabled=false,serial=0}
+local function now() return GetTime and GetTime() or 0 end
+function M.Entity(e) return e and (tostring(e.prefab or "?").."#"..tostring(e.GUID or "?")) or "none" end
+function M.Point(v) return v and string.format("%.2f,%.2f",v.x,v.z) or "none" end
+local function value(v)
+ if type(v)=="number" then return string.format("%.3f",v) end
