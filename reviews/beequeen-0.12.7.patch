+local function line(fields)
+ local keys={};for key in pairs(fields) do keys[#keys+1]=key end;table.sort(keys)
+ local out={"[ShadowSelf][QueenDebug]"};for _,key in ipairs(keys) do out[#out+1]=key.."="..value(fields[key]) end
