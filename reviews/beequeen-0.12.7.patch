+ local guards={};local signature={};local boost,sleep,frozen,near=0,0,0,math.huge
+ for _,e in ipairs(q.debug_bees or {}) do if e:IsValid() then
+  local mode=status.Sleeping(e) and "sleep" or status.Frozen(e) and "frozen" or require("shadowself/control/queendash").Dashing(e) and "dash" or "normal"
+  if mode=="dash" then boost=boost+1 elseif mode=="sleep" then sleep=sleep+1 elseif mode=="frozen" then frozen=frozen+1 end
+  local d=math.sqrt(pos:DistSq(e:GetPosition()));near=math.min(near,d)
+  local build=e.AnimState and e.AnimState.GetBuild and e.AnimState:GetBuild() or "?"
+  signature[#signature+1]=M.Entity(e)..":"..mode
+  guards[#guards+1]=M.Entity(e)..":"..mode..":"..build..":"..animation(e)..":"..string.format("%.1f",d)
+ end end
+ table.sort(guards);table.sort(signature)
+ local fields={phase=q.phase,stage=q.stage,mode=q.dash_cycle and q.dash_cycle.mode or "none",target=M.Entity(c.h.ent),blocked=c.blocked==true,reason=c.status or "none"}
+ M.Change(c,"decision",table.concat({tostring(fields.phase),tostring(fields.stage),fields.mode,fields.target,tostring(fields.blocked)},"/"),fields)
+ M.Change(c,"guards",table.concat(signature,";"),{count=#guards,boosted=boost,sleeping=sleep,frozen=frozen,detail=table.concat(guards,";")})
+ local pc=p.components.playercontroller;local busy=pc:IsBusy();local hp=p.replica and p.replica.health
+ local percent=hp and hp.GetPercent and hp:GetPercent()
+ if percent and s.hp and percent<s.hp then M.Event(c,"hurt",{health=percent,delta=percent-s.hp,anim=animation(p)}) end
+ if percent then s.hp=percent end
+ if now()<(s.next_snapshot or 0) then return end;s.next_snapshot=now()+2
+ local distance=s.previous and math.sqrt(pos:DistSq(s.previous)) or 0
+ local stalled=s.previous~=nil and distance<.15 and s.goal~=nil and pos:DistSq(s.goal)>1 and s.last_move~=nil and now()-s.last_move<2.5 and not busy
+ s.previous=Vector3(pos.x,0,pos.z)
