+ if s.lines>=24 and event~="snapshot" and event~="fight_end" then s.dropped=s.dropped+1;return end
+ s.lines=s.lines+1
+ local out={event=event,version=M.VERSION,fight=s.fight,t=t-s.start}
+ local queen=c.beequeen;if queen then out.phase=queen.phase;out.stage=queen.stage end
+ for key,v in pairs(fields or {}) do out[key]=v end;line(out)
+end
+function M.Change(c,key,signature,fields)
+ local s=M.enabled and c and c._queen_debug;if not s or s.last[key]==signature then return end
+ s.last[key]=signature;M.Event(c,key,fields)
+end
+function M.Throttle(c,key,seconds,event,fields)
+ local s=M.enabled and c and c._queen_debug;if not s or now()<(s.throttle[key] or 0) then return end
+ s.throttle[key]=now()+seconds;M.Event(c,event,fields)
+end
+function M.End(c,reason)
+ if c and c._queen_debug then M.Event(c,"fight_end",{reason=reason});c._queen_debug=nil end
+end
+function M.Block(c,source,victim)
+ local s=M.enabled and c and c._queen_debug;if not s then return end
+ local key=source=="select" and "select_veto" or "attack_veto"
+ s.counts[key]=(s.counts[key] or 0)+1
+ if source~="select" then M.Throttle(c,"attack_veto:"..source,1,"attack_block",{source=source,target=M.Entity(victim)}) end
+end
+function M.Performed(c,data)
+ if not M.enabled or not c or not c._queen_debug or type(data)~="table" then return end
+ local act=data
+ if type(data.action)=="table" and data.action.action then act=data.action end
+ if act.action==ACTIONS.ATTACK then M.Event(c,"attack_performed",{target=M.Entity(act.target)}) end
+end
+function M.Equip(c,event,item,role,extra)
+ if not M.enabled or not c or not c._queen_debug then return end
+ local fields={item=M.Entity(item),role=role,held=M.Entity(c.player.replica.inventory:GetEquippedItem(EQUIPSLOTS.HANDS))}
+ for k,v in pairs(extra or {}) do fields[k]=v end
+ M.Event(c,"equip_"..event,fields)
+end
+function M.Move(c,point,label)
+ local s=M.enabled and c and c._queen_debug;if not s then return end
+ s.last_move=now();s.goal=point
+ M.Throttle(c,"move:"..tostring(label),.5,"move_dispatch",{pos=M.Point(c.player:GetPosition()),goal=M.Point(point),reason=label})
+end
+local function animation(e)
+ local n=require("shadowself/native").Get();local util=n and n.ENT_util
+ return (util and util.GetAnimation and util:GetAnimation(e)) or "unknown"
+end
+local function sample(q)
